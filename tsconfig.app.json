{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@ApiData/*": ["src/@ApiData/*"],
      "@Ensighten/*": ["src/DanskeSpil/@Ensighten/*"],
      "@ErrorHandling/*": ["src/DanskeSpil/@ErrorHandling/*"],
      "@KlubLotto/*": ["C:/Projects/danskespil-website/Website/Components/DanskeSpil/Domain/Feature.KlubLotto/*"],
      "@Mock/*": ["src/@Mock/*"],
      "@SharedScripts/*": ["src/DanskeSpil/@SharedScripts/*"],
      "@SharedScripts": ["src/DanskeSpil/@SharedScripts"]
    }
  },
  "include": ["src"]
}
